# ============================================
# AI Nexus - Environment Variables
# Place this in TrendingUpdate/.env (project root)
# ============================================

# --- Supabase PostgreSQL (Required) ---
user=postgres.your-project-ref
password=your-db-password
host=aws-0-us-west-2.pooler.supabase.com
port=6543
dbname=postgres

# --- Qwen LLM API (Required for summarization) ---
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_API_KEY=sk-your-qwen-api-key

# --- Jina Reader API (Optional, for JS-rendered pages) ---
JINA_API_KEY=

# --- Serper Search API (Optional) ---
SERPER_API_KEY=

# --- Logging ---
LOG_LEVEL=INFO
