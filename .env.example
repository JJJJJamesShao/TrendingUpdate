# ============================================
# AI Nexus — Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- Supabase PostgreSQL (Transaction Mode / Pooler) ---
user=postgres.xxxxxxxxxxxxxxxxxxxx
password=your-supabase-db-password
host=aws-0-us-west-2.pooler.supabase.com
port=6543
dbname=postgres

# --- MiniMax LLM API ---
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.5
MINIMAX_API_KEY=sk-your-minimax-api-key

# --- Optional: Jina Reader (for JS-heavy pages) ---
# JINA_API_KEY=jina_xxxxxxxxxxxx

# --- Optional: Serper Search ---
# SERPER_API_KEY=your-serper-key
